# In production every value below is injected by Terraform (Lambda environment)
# or fetched from SSM Parameter Store — nothing is read from a .env file.
# This file documents the knobs for local experimentation only.

# --- AWS ---
# Region the SSM parameters and DynamoDB tables live in.
AWS_REGION=us-east-1

# --- SSM parameter names (SecureString; values are created out-of-band) ---
BOT_TOKEN_PARAM=/telegram/bot_token
WEBHOOK_SECRET_PARAM=/telegram/webhook_secret

# --- DynamoDB table names ---
USERS_TABLE=WaterBotUsers
LOGS_TABLE=WaterBotLogs

# --- Behaviour ---
# IANA timezone used to bucket "today" and close out yesterday's prompt.
# Must match the Terraform bot_timezone variable.
BOT_TZ=UTC
